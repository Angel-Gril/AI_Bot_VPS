# ============================================================
# 复制为 .env 后填写；.env 已被 .gitignore 忽略
#   cp .env.example .env && vi .env
# ============================================================

# ---------- 中转 VPS ----------
# 你的中转机（必须有公网 IP / 或已备案域名）
RELAY_HOST=203.0.113.10
RELAY_PORT=22
# 中转机上用于「反向隧道」的受限账号（见 docs/03-ssh-relay.md）
RELAY_USER=tunnel
# 中转机上本机监听端口：只绑 127.0.0.1，公网不可达
RELAY_LISTEN=127.0.0.1:2222
# 沙箱侧被转发的目标（一般是本机 sshd）
SANDBOX_TARGET=127.0.0.1:22
# 中转机 SSH 主机键指纹（首次安装时由 install.sh 写入 known_hosts）
# 获取方式：ssh-keyscan -t ed25519 <RELAY_HOST> | ssh-keygen -lf -
RELAY_HOST_FINGERPRINT=SHA256:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# ---------- 沙箱侧 ----------
# 沙箱上 sshd 应只监听回环；本机 sshd 端口
SANDBOX_SSHD_PORT=22
# 反向隧道用的私钥（install.sh 会自动生成）
TUNNEL_KEY=~/.ssh/tunnel

# ---------- 活动租约（Sesame/Sprite 类平台） ----------
TASK_NAME=keepalive
# 租约有效期：平台在租约过期后才会考虑挂起，故它等于「保活失效后的容忍窗口」
TASK_TTL=5m
# 续租间隔：明显小于 TTL，留出抖动与重试空间
TASK_INTERVAL=60

# ---------- 日志 ----------
# 日志轮转阈值（字节）与保留代数
LOG_MAX_BYTES=1048576
LOG_KEEP=3
